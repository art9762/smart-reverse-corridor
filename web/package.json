{
  "name": "smart-reverse-corridor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Operator and viewer dashboard for the Smart Reverse Corridor traffic controller.",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && VITE_DEMO=1 vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "1.7.7",
    "mqtt": "5.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@types/node": "20.16.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.0",
    "postcss": "8.4.45",
    "tailwindcss": "3.4.10",
    "typescript": "^5.5.4",
    "vite": "5.4.6",
    "vitest": "2.0.5"
  }
}
