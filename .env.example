# === MQTT ===
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USER=
MQTT_PASS=

# === Controller ===
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=8000
CONTROLLER_LOG_LEVEL=INFO

ZONE_LENGTH_M=800
GREEN_MIN_S=15
GREEN_MAX_S=240
YELLOW_S=3
ALL_RED_GUARD_S=5
CLEAR_TIMEOUT_S=60
PRIO_W_QUEUE=1.0
PRIO_W_WAIT=0.05
PRIO_W_TRUCK=0.5

# === ML/CV ===
ML_MODEL=yolov8n.pt
ML_CONF=0.35
ML_IOU=0.5
ML_DEVICE=cpu
ML_VIDEO_A_IN=/data/cam_A_in.mp4
ML_VIDEO_A_OUT=/data/cam_A_out.mp4
ML_VIDEO_B_IN=/data/cam_B_in.mp4
ML_VIDEO_B_OUT=/data/cam_B_out.mp4

# === InfluxDB ===
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=devtoken-change-me
INFLUX_ORG=cet
INFLUX_BUCKET=corridor

# === Web ===
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_MQTT_WS_URL=ws://localhost:9001
